        message +=
            `• ${product.name}%0A`;

        message +=
            `  Cantidad: ${product.quantity}%0A`;

        message +=
            `  Precio: RD$${formatNumber(product.price)}%0A`;

        message +=
            `  Subtotal: RD$${formatNumber(subtotal)}%0A%0A`;

    });


    message +=
        `TOTAL: RD$${formatNumber(calculateTotal())}%0A%0A`;

    message +=
        "Me gustaría recibir las instrucciones para realizar el pago. Gracias. 🦋";


    const whatsappNumber =
        "18094195782";


