.cart-controls button {
    width: 32px;
    height: 32px;

    border: none;

    border-radius: 8px;

    background: var(--verde);

    color: var(--verde-oscuro);

    cursor: pointer;

    font-weight: bold;
}

.cart-controls span {
    min-width: 25px;

    text-align: center;

    font-weight: bold;
}

.remove-item {
    background: #f8d7da !important;

    color: #9c2535 !important;
}

.cart-item-total {
    min-width: 95px;

    text-align: right;

    color: var(--vino);

    font-weight: bold;
}

.cart-summary {
    padding: 25px;

    background: var(--verde-claro);

    border-top: 1px solid var(--borde);
}

.cart-total {
    display: flex;

    align-items: center;
    justify-content: space-between;

    margin-bottom: 20px;

    color: var(--texto);

    font-size: 18px;
}

.cart-total strong {
    color: var(--vino);

    font-size: 25px;
}

.btn-order {
    width: 100%;
}


/* =========================================
   CONTACTO
========================================= */

.contact {
    background: var(--crema);
}

.contact-grid {
    display: grid;

    grid-template-columns: repeat(4, 1fr);

    gap: 18px;
}

.contact-card {
    padding: 28px 18px;

    text-align: center;

    background: var(--blanco);

    border: 1px solid var(--borde);

    border-radius: 20px;

    transition: var(--transicion);
}

.contact-card:hover {
    transform: translateY(-7px);

    box-shadow: var(--sombra);

    border-color: var(--verde);
}

.contact-icon {
    width: 60px;
    height: 60px;

    display: flex;
    align-items: center;
    justify-content: center;

    margin: 0 auto 15px;

    border-radius: 50%;

    font-size: 25px;
}

.contact-icon.whatsapp {
    background: #dcf8e7;
    color: #13be52;
}

.contact-icon.instagram {
    background: #f5e1e8;
    color: var(--vino);
}

.contact-icon.email {
    background: var(--verde-claro);
    color: var(--vino);
}

.contact-card h3 {
    color: var(--vino);

    margin-bottom: 7px;
}

.contact-card p {
    color: var(--texto-suave);

    font-size: 13px;

    word-break: break-word;

    margin-bottom: 12px;
}

.contact-card span {
    color: var(--verde-oscuro);

    font-size: 12px;
    font-weight: bold;
}


/* =========================================
   FOOTER
========================================= */

.footer {
    background: var(--vino-oscuro);

    color: var(--blanco);
}

.footer-content {
    min-height: 150px;

    display: flex;

    align-items: center;
    justify-content: space-between;

    gap: 30px;
}

.footer-logo {
    display: flex;

    align-items: center;

    gap: 10px;

    color: var(--verde);

    font-size: 20px;
}

.footer-brand p {
    margin-top: 7px;

    color: #dbcbd0;

    font-size: 13px;
}

.footer-social {
    display: flex;

    gap: 10px;
}

.footer-social a {
    width: 40px;
    height: 40px;

    display: flex;

    align-items: center;
    justify-content: center;

    border-radius: 50%;

    background: rgba(255,255,255,0.1);

    color: var(--blanco);

    transition: var(--transicion);
}

.footer-social a:hover {
    background: var(--verde);

    color: var(--vino-oscuro);

    transform: translateY(-3px);
}

.footer-bottom {
    padding: 18px;

    text-align: center;

    border-top: 1px solid rgba(255,255,255,0.1);

    color: #d8cbd0;

    font-size: 12px;
}


/* =========================================
   NOTIFICACIÓN
========================================= */

.notification {
    position: fixed;

    right: 25px;
    bottom: 25px;

    z-index: 2000;

    display: flex;

    align-items: center;

    gap: 10px;

    padding: 14px 18px;

    border-radius: 12px;

    background: var(--vino-oscuro);

    color: var(--blanco);

    box-shadow: var(--sombra);

    transform: translateY(130px);

    opacity: 0;

    pointer-events: none;

    transition: 0.4s ease;
}

.notification.show {
    transform: translateY(0);

    opacity: 1;
}

.notification i {
    color: var(--verde);
}


/* =========================================
   ANIMACIONES
========================================= */

@keyframes floatButterfly {

    0%,
    100% {
        transform: translateY(0) rotate(-3deg);
    }

    50% {
        transform: translateY(-12px) rotate(3deg);
    }
}


/* =========================================
   RESPONSIVE
========================================= */

@media (max-width: 1050px) {

    .nav {
        gap: 14px;
    }

    .services-grid {
        grid-template-columns: repeat(2, 1fr);
    }

    .products-grid {
        grid-template-columns: repeat(2, 1fr);
    }

    .contact-grid {
        grid-template-columns: repeat(2, 1fr);
    }

}


@media (max-width: 800px) {

    .menu-toggle {
        display: block;
    }

    .nav {
        position: absolute;

        top: 78px;
        left: 0;
        right: 0;

        display: none;

        flex-direction: column;

        align-items: stretch;

        gap: 0;

        padding: 15px;

        background: var(--blanco);

        border-bottom: 1px solid var(--borde);

        box-shadow: var(--sombra);
    }

    .nav.active {
        display: flex;
    }

    .nav a {
        padding: 13px 10px;
    }

    .nav-cart {
        justify-content: center;
    }

    .hero {
        padding: 80px 0;
    }

    .hero-content {
        grid-template-columns: 1fr;
    }

    .hero-butterfly {
        min-height: 300px;
    }

    .about-content {
        grid-template-columns: 1fr;

        text-align: center;
    }

    .payment-grid {
        grid-template-columns: 1fr;
    }

}


@media (max-width: 600px) {

    .section {
        padding: 70px 0;
    }

    .services-grid,
    .products-grid,
    .contact-grid {
        grid-template-columns: 1fr;
    }

    .hero h1 {
        font-size: 48px;
    }

    .hero-buttons {
        flex-direction: column;
    }

    .hero-buttons .btn {
        width: 100%;
    }

    .product-bottom {
        align-items: stretch;

        flex-direction: column;
    }

    .product-btn {
        width: 100%;
    }

    .cart-item {
        flex-wrap: wrap;
    }

    .cart-item-total {
        margin-left: auto;
    }

    .footer-content {
        flex-direction: column;

        text-align: center;

        padding: 35px 0;
    }

    .other-products {
        padding: 35px 20px;
    }

}


@media (max-width: 420px) {

    .logo-text strong {
        font-size: 18px;
    }

    .logo-butterfly {
        font-size: 30px;
    }

    .hero h1 {
        font-size: 42px;
    }

    .section-title h2 {
        font-size: 30px;
    }

    .account-number {
        font-size: 12px;
    }

}
